+
+package com.facebook.react.uimanager
+
+import android.app.Activity
+import android.content.Context
+import android.content.res.Configuration
+import android.content.res.Resources
+import android.graphics.Point
+import android.util.DisplayMetrics
+import android.util.TypedValue
+import android.view.Display
+import android.view.WindowManager
+import com.facebook.react.bridge.ReactContext
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotSame
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.kotlin.any
+import org.mockito.kotlin.doAnswer
+import org.mockito.kotlin.mock
+import org.mockito.kotlin.whenever
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, sdk = [28, 34])
+class DisplayMetricsHolderTest {
+  @Before
+  fun resetMetrics() {
+    DisplayMetricsHolder.setScreenDisplayMetrics(null)
+  }
+
+  @Test
+  fun preservesWindowDensityWhenDefaultDisplayHasPhoneDensity() {
+    val window = metrics(1f, 1.25f)
+    val context = displayContext(window, 1920, 1080)
+
+    DisplayMetricsHolder.initDisplayMetrics(context)
+
+    assertMetrics(window, 1920, 1080)
+    assertEquals(720, window.widthPixels)
+    assertEquals(600, window.heightPixels)
+    assertNotSame(window, DisplayMetricsHolder.getScreenDisplayMetrics())
+  }
+
+  @Test
+  fun everyInitializationIsConsistentAcrossPhoneDexAndRotation() {
+    val phone = metrics(3f, 1.25f)
+    val dex = metrics(1f, 1.25f)
+    val contexts = listOf(
+        Triple(displayContext(phone, 1080, 2400), phone, Point(1080, 2400)),
+        Triple(displayContext(dex, 1920, 1080), dex, Point(1920, 1080)),
+        Triple(displayContext(dex, 1080, 1920), dex, Point(1080, 1920)),
+        Triple(displayContext(phone, 1080, 2400), phone, Point(1080, 2400)),
+    )
+
+    for ((context, window, screenSize) in contexts) {
+      repeat(3) {
+        DisplayMetricsHolder.initDisplayMetrics(context)
+        // Measurement immediately after any reset must already use the window's scale.
+        assertMetrics(window, screenSize.x, screenSize.y)
+      }
+    }
+  }
+
+  @Test
+  fun reactContextUsesTheCurrentActivityDisplay() {
+    val activity = mock<Activity>()
+    val window = metrics(1f, 1f)
+    displayContext(window, 1920, 1080, activity)
+    val reactContext = mock<ReactContext>()
+    displayContext(metrics(3f, 1f), 1080, 2400, reactContext)
+    whenever(reactContext.currentActivity).thenReturn(activity)
+
+    DisplayMetricsHolder.initDisplayMetrics(reactContext)
+
+    assertMetrics(window, 1920, 1080)
+  }
+
+  @Test
+  fun preservesResourceFontConversion() {
+    val configuration = Configuration().apply {
+      densityDpi = 160
+      fontScale = 1.5f
+    }
+    val window = RuntimeEnvironment.getApplication()
+        .createConfigurationContext(configuration).resources.displayMetrics
+
+    DisplayMetricsHolder.initDisplayMetrics(displayContext(window, 1920, 1080))
+
+    assertMetrics(window, 1920, 1080)
+  }
+
+  @Test
+  fun nonVisualContextsKeepResourceMetrics() {
+    val window = metrics(2f, 0.85f)
+    val context = displayContext(window, 1920, 1080)
+    whenever(context.getSystemService(Context.WINDOW_SERVICE))
+        .thenThrow(UnsupportedOperationException("Not a visual context"))
+
+    DisplayMetricsHolder.initDisplayMetrics(context)
+
+    assertMetrics(window, window.widthPixels, window.heightPixels)
+  }
+
+  private fun metrics(density: Float, fontScale: Float): DisplayMetrics =
+      DisplayMetrics().apply {
+        this.density = density
+        densityDpi = (density * 160).toInt()
+        scaledDensity = density * fontScale
+        widthPixels = 720
+        heightPixels = 600
+      }
+
+  @Suppress("DEPRECATION")
+  private fun displayContext(
+      window: DisplayMetrics,
+      width: Int,
+      height: Int,
+      context: Context = mock(),
+  ): Context {
+    val resources = mock<Resources>()
+    val display = mock<Display>()
+    val windowManager = mock<WindowManager>()
+    whenever(context.resources).thenReturn(resources)
+    whenever(resources.displayMetrics).thenReturn(window)
+    whenever(context.getSystemService(Context.WINDOW_SERVICE)).thenReturn(windowManager)
+    whenever(windowManager.defaultDisplay).thenReturn(display)
+    doAnswer {
+      it.getArgument<Point>(0).set(width, height)
+      null
+    }.whenever(display).getRealSize(any())
+    doAnswer {
+      it.getArgument<DisplayMetrics>(0).setTo(metrics(3f, 1f))
+      null
+    }.whenever(display).getRealMetrics(any())
+    return context
+  }
+
+  private fun assertMetrics(window: DisplayMetrics, width: Int, height: Int) {
+    val cached = DisplayMetricsHolder.getScreenDisplayMetrics()
+    assertEquals(window.density, cached.density, 0f)
+    assertEquals(window.densityDpi, cached.densityDpi)
+    assertEquals(window.scaledDensity, cached.scaledDensity, 0f)
+    assertEquals(width, cached.widthPixels)
+    assertEquals(height, cached.heightPixels)
+    assertEquals(23f, PixelUtil.toDIPFromPixel(23 * window.density), 0.001f)
+    for (size in listOf(12f, 16f, 32f)) {
+      assertEquals(
+          TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, size, window),
+          PixelUtil.toPixelFromSP(size),
+          0f,
+      )
+    }
+  }
+}
